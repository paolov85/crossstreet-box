# Copiare questo file in .env e completare i valori

# Database. In locale DB_PORT e DB_SSL_CA si possono lasciare vuoti.
DB_HOST=localhost
DB_PORT=
DB_USER=root
DB_PASSWORD=
DB_NAME=crossstreet_box
# Certificato CA del database online (testo completo, da -----BEGIN a -----END)
DB_SSL_CA=

# Chiave segreta con cui il server firma i token JWT: una stringa lunga e
# casuale, diversa in ogni ambiente. Si può generare con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Indirizzo del front end, autorizzato dal CORS. In locale si può lasciare
# vuoto: vale http://localhost:5173, la porta di Vite.
CLIENT_URL=
