# Variabili usate solo dai test (npm test). Il database di test è separato
# da quello di sviluppo, perché i test svuotano le tabelle a ogni prova.
# Le altre variabili (utente, password, JWT_SECRET) arrivano dal file .env.
#
# Il database di test si crea una volta sola, dalla cartella server, con:
# sed 's/crossstreet_box/crossstreet_box_test/' migrations.sql | mysql -u root -p
DB_NAME=crossstreet_box_test
